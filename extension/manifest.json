{
  "manifest_version": 3,
  "name": "303-proxy",
  "version": "1.0",
  "description": "Прокси на Python",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "webRequest",
    "storage",
    "http://72.56.72.131/",
    "https://72.56.72.131/"
  ],
  "host_permissions": [
    "http://72.56.72.131:8080/",
    "https://72.56.72.131:8080/",
    "http://72.56.72.131:8888/",
    "https://72.56.72.131:8888/"
  ]
}