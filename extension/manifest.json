{
  "manifest_version": 3,
  "name": "303-proxy",
  "version": "1.0",
  "description": "Прокси на Python",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "webRequest",
    "storage",
    "http://МОЙ_URL/",
    "https://МОЙ_URL/"
  ],
  "host_permissions": [
    "http://ТВОЙ_СЕРВЕР:8080/",
    "https://ТВОЙ_СЕРВЕР:8080/",
    "http://ТВОЙ_СЕРВЕР:8888/",
    "https://ТВОЙ_СЕРВЕР:8888/"
  ]
}